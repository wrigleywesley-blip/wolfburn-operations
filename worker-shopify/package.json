{
  "name": "wolfburn-shopify-sync",
  "version": "0.1.0",
  "private": true,
  "description": "Cloudflare Worker that proxies the Shopify Admin GraphQL API for the Wolfburn Operations dashboard. Read scopes only. Cached 60s.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "secret:domain": "wrangler secret put SHOPIFY_SHOP_DOMAIN",
    "secret:token": "wrangler secret put SHOPIFY_ADMIN_ACCESS_TOKEN"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240502.0",
    "typescript": "^5.5.0",
    "wrangler": "^3.60.0"
  }
}
