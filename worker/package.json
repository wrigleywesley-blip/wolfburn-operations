{
  "name": "wolfburn-meta-sync",
  "version": "0.1.0",
  "private": true,
  "description": "Cloudflare Worker that proxies the Meta Marketing API for the Wolfburn Operations dashboard. Read-only, ads_read scope. Cached 5 min.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "secret:token": "wrangler secret put META_ACCESS_TOKEN",
    "secret:account": "wrangler secret put META_AD_ACCOUNT_ID"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240502.0",
    "typescript": "^5.5.0",
    "wrangler": "^3.60.0"
  }
}
